{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Knot Studio",
  "version": "0.1.0",
  "identifier": "studio.knot.local",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Knot Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [],
    "targets": "all"
  }
}
