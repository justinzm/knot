{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knot Preflight Report",
  "description": "Formal schema for a persisted Knot preflight validation report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_type",
    "created_at",
    "status",
    "checks"
  ],
  "properties": {
    "report_type": {
      "type": "string",
      "const": "preflight"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "schema",
        "input",
        "message"
      ],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "taskboard",
            "project-spec",
            "custom"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    }
  }
}
