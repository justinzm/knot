{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knot Taskboard",
  "description": "Formal schema for a Knot taskboard file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "workflow",
    "description",
    "stories"
  ],
  "properties": {
    "project": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "workflow": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 3,
      "maxLength": 4000
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "./story.schema.json"
      }
    },
    "metadata": {
      "type": "object",
      "description": "Structured, taskboard-level metadata for project-specific orchestration.",
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "description": "Open extension point for non-core taskboard fields.",
      "additionalProperties": true
    }
  }
}
